# OpenAI（app.generation.mode=openai の場合に必須）
OPENAI_API_KEY=

# Amazon Polly（app.generation.mode=openai の場合に必須）
# 認証情報・regionはAWS SDKのデフォルトプロバイダチェーンで解決する
# （ローカルはこの環境変数、本番はECS IAM Role）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ローカル開発ではapplication-local.ymlによりstub実装が既定（APIコストなし）。
# 実際にOpenAI/Pollyへ接続して確認したい場合のみ、以下を一時的に上書きする
# APP_GENERATION_MODE=openai
